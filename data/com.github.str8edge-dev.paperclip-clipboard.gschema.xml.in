<?xml version="1.0" encoding="utf-8" ?>
<schemalist>
    <schema id="@APP_ID@" path="@GRESOURCE_PATH@/">
        <key name="max-content-height" type="i">
              <default>300</default>
              <summary>Maximum Content Height</summary>
        </key>
        <key name="window-width" type="i">
              <default>400</default>
              <summary>Default window width</summary>
        </key>
        <key name="header-name" type="s">
            <default>"@APP_NAME@"</default>
            <summary>Header Text</summary>
        </key>
        <key name="show-count" type="b">
            <default>false</default>
            <summary>Item Count</summary>
        </key>
        <key name="image-preview-mode" type="u">
            <default>0</default>
            <summary>Image Preview Mode</summary>
        </key>
        <key name="history-limit" type="i">
            <default>100</default>
            <summary>History limit</summary>
        </key>
        <key name="save-history" type="b">
            <default>true</default>
            <summary>Save History</summary>
        </key>
        <key name="show-tray" type="b">
            <default>true</default>
            <summary>Show Tray</summary>
        </key>
    </schema>
</schemalist>
